# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Google Cloud OAuth 2.0 Client Credentials
# Configure these in your GitHub Secrets or AI Studio Secrets panel.
# The Secrets Gradle Plugin injects these into BuildConfig automatically.
GOOGLE_WEB_CLIENT_ID=DEFAULT_GOOGLE_WEB_CLIENT_ID
GOOGLE_WEB_CLIENT_SECRET=DEFAULT_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_ANDROID_CLIENT_ID=DEFAULT_GOOGLE_ANDROID_CLIENT_ID
GOOGLE_PROJECT_ID=DEFAULT_GOOGLE_PROJECT_ID
